<Project Sdk="Microsoft.NET.Sdk">

  <!-- Point d'entrée Windows : assemble le Core, l'UI Avalonia et la plateforme Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Pointik.App.Windows</RootNamespace>
    <AssemblyName>Pointik</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>..\Pointik.UI\Assets\Pointik.ico</ApplicationIcon>
    <AssemblyTitle>Pointik</AssemblyTitle>
    <Description>Pointik — mise en valeur de la souris et du clavier</Description>
    <!-- Publication : un seul fichier autonome (voir publish.ps1). Pas de trimming : Avalonia
         utilise la réflexion (XAML, liaisons) et le gain ne justifie pas le risque. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pointik.Core\Pointik.Core.csproj" />
    <ProjectReference Include="..\Pointik.UI\Pointik.UI.csproj" />
    <ProjectReference Include="..\Pointik.Platform.Windows\Pointik.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
