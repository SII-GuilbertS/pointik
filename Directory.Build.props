<Project>
  <!-- Réglages communs à tous les projets de la solution -->
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>1.3.1</Version>
    <Product>Pointik</Product>
    <Company>Pointik</Company>
    <Copyright>Pointik — logiciel gratuit</Copyright>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- Version unique d'Avalonia pour toute la solution -->
    <AvaloniaVersion>11.3.20</AvaloniaVersion>
  </PropertyGroup>

  <!-- En Release, aucun fichier de symboles : l'exe publié reste seul. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
